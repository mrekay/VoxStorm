{
  "name": "voxstorm",
  "version": "0.8.1",
  "description": "Claude Code ve Codex oturumlarını tek pencereden yöneten Windows, macOS ve Linux masaüstü uygulaması",
  "author": "mrekay",
  "homepage": "https://github.com/mrekay/claudelot",
  "desktopName": "voxstorm.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrekay/claudelot.git"
  },
  "main": "src/main/main.js",
  "private": true,
  "productName": "VoxStorm",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/make-icon.js && electron-builder --win",
    "pack": "node scripts/make-icon.js && electron-builder --win --dir",
    "dist:mac": "node scripts/make-icon.js --size 1024 && electron-builder --mac",
    "dist:linux": "node scripts/make-icon.js --size 512 && electron-builder --linux --x64"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^5.65.21",
    "dompurify": "^3.4.17",
    "marked": "^18.2.0",
    "mssql": "^12.7.14",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.claudelot.app",
    "productName": "VoxStorm",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "package.json",
      "!**/node_modules/**/*.{map,d.ts,d.mts,d.cts}",
      "!**/node_modules/@azure/msal-browser/**",
      "!**/node_modules/@azure/*/dist/{browser,react-native,workerd}/**",
      "!**/node_modules/@typespec/*/dist/{browser,react-native}/**"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VoxStorm",
      "artifactName": "VoxStorm-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "VoxStorm-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "artifactName": "VoxStorm-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "VoxStorm ${version}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "executableName": "voxstorm",
      "maintainer": "mrekay <63546213+mrekay@users.noreply.github.com>",
      "synopsis": "Claude Code ve Codex oturumlarını tek pencereden yönet",
      "artifactName": "VoxStorm-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "curl"
      ]
    }
  }
}
